{
    "name": "jengo-agency/acf-file-picker",
    "description": "An Advanced Custom Field to pick a file from a chosen directory.",
    "type": "wordpress-plugin",
    "version": "2.0.0",
    "authors": [
        {
            "name": "David Smith"
        }
        ,
        {
            "name": "Alapiere"
        }
    ],
    "require": {
        "composer/installers": "~2.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "php-mock/php-mock": "^2.0",
        "php-mock/php-mock-mockery": "^1.4",
        "phpspec/phpspec": "^7.0"
    },
	"autoload-dev": {
		"files": ["classes/acf-file_picker-v5.php"]
	},
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
